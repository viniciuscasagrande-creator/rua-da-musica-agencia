// Schema Prisma — Módulo Equipe de Vendas & Distribuição Turística B2B (PDT DiskIngressos)
// Valores monetários usam centavos (Int); percentuais usam pontos-base (600 = 6%).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SalesAgentStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum AgencyStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ReservationStatus {
  HELD
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum CommissionEntryKind {
  ACCRUAL
  REVERSAL
  SETTLEMENT
}

enum CommissionRecipientKind {
  SALES_AGENT
  AGENCY
}

model SalesAgent {
  id                String           @id @default(cuid())
  producerId        String           @default("1dd467ed-af6d-401b-a0ed-4d50523ac331")
  userId            String?          // Vincular ao usuário existente, quando houver acesso ao portal
  name              String
  email             String?
  phone             String?
  document          String?
  pixKey            String?
  status            SalesAgentStatus @default(ACTIVE)
  statusLabel       String?          @default("Ativo")
  role              String?          @default("Promoter")
  initials          String?          @default("PR")
  avatarBg          String?          @default("bg-blue-600")
  salesCount        Int              @default(0)
  ticketsCount      Int              @default(0)
  revenue           Decimal          @default(0) @db.Decimal(12, 2)
  goalTarget        Int              @default(200)
  goalPct           Int              @default(0)
  goalColor         String?          @default("bg-blue-500")
  commission        Decimal          @default(0) @db.Decimal(12, 2)
  commissionPaid    Decimal          @default(0) @db.Decimal(12, 2)
  commissionPending Decimal          @default(0) @db.Decimal(12, 2)
  commissionModel   String?          @default("Percentual (5%)")
  conversion        Decimal          @default(0) @db.Decimal(5, 2)
  linkCode          String?
  couponCode        String?
  clicks            Int              @default(0)
  sessions          Int              @default(0)
  permissionsJson   Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  links             SalesLink[]
  rules             CommissionRule[]

  @@index([producerId, status])
  @@unique([producerId, userId])
}

model Agency {
  id            String             @id @default(cuid())
  producerId    String             @default("1dd467ed-af6d-401b-a0ed-4d50523ac331")
  legalName     String
  document      String             // CNPJ normalizado; aplicar validação e proteção no serviço
  contactName   String?
  email         String?
  status        AgencyStatus       @default(PENDING)
  cityUf        String?            @default("Curitiba - PR")
  state         String?            @default("PR")
  quotaLimit    Int                @default(500)
  bookingsCount Int                @default(0)
  ticketsSold   Int                @default(0)
  revenue       Decimal            @default(0) @db.Decimal(12, 2)
  packagesCount Int                @default(1)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  events        AgencyEvent[]
  links         SalesLink[]
  reservations  GroupReservation[]
  rules         CommissionRule[]

  @@unique([producerId, document])
  @@index([producerId, status])
}

model AgencyEvent {
  id           String             @id @default(cuid())
  agencyId     String
  eventId      String             @default("197bc60b-5b3a-4a29-9c63-c4a24ca9f082")
  active       Boolean            @default(true)
  feeBps       Int                @default(600) // Taxa administrativa contratada: 6% inicial
  createdAt    DateTime           @default(now())
  agency       Agency             @relation(fields: [agencyId], references: [id])
  reservations GroupReservation[]

  @@unique([agencyId, eventId])
  @@index([eventId, active])
}

model SalesLink {
  id           String            @id @default(cuid())
  eventId      String            @default("197bc60b-5b3a-4a29-9c63-c4a24ca9f082")
  code         String            @unique
  agentId      String?
  agencyId     String?
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  agent        SalesAgent?       @relation(fields: [agentId], references: [id])
  agency       Agency?           @relation(fields: [agencyId], references: [id])
  attributions SaleAttribution[]

  @@index([eventId, active])
  // Serviço/SQL: exatamente um de agentId e agencyId deve ser preenchido.
}

model GroupReservation {
  id             String            @id @default(cuid())
  agencyEventId  String
  agencyId       String
  agencyName     String?
  ticketTypeId   String            // Mapear lote/tipo de ingresso existente
  quantity       Int
  status         ReservationStatus @default(HELD)
  statusLabel    String?           @default("Voucher emitido")
  groupName      String?
  coordinator    String?
  visitDate      String?
  visitTime      String?
  baseAmount     Decimal           @default(0) @db.Decimal(12, 2)
  diskFeeAmount  Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal           @default(0) @db.Decimal(12, 2)
  qrCode         String?
  originCity     String?           @default("Curitiba - PR")
  transport      String?           @default("Ônibus Executivo")
  itemsJson      Json?
  expiresAt      DateTime          @default(now())
  orderId        String?           @unique
  idempotencyKey String            @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  agencyEvent    AgencyEvent       @relation(fields: [agencyEventId], references: [id])
  agency         Agency            @relation(fields: [agencyId], references: [id])

  @@index([agencyEventId, status, expiresAt])
  // Confirmar agência/vínculo e reservar estoque no motor único, na mesma transação.
}

model SaleAttribution {
  id          String            @id @default(cuid())
  orderId     String            @unique
  eventId     String
  salesLinkId String?
  agentId     String?
  agencyId    String?
  createdAt   DateTime          @default(now())
  salesLink   SalesLink?        @relation(fields: [salesLinkId], references: [id])
  entries     CommissionEntry[]

  @@index([eventId, createdAt])
  // Atribuição imutável após pagamento; aplicar regra de precedência no checkout.
}

model CommissionRule {
  id            String                  @id @default(cuid())
  eventId       String
  recipientKind CommissionRecipientKind
  agentId       String?
  agencyId      String?
  rateBps       Int?                    // 1000 = 10%; preencher rateBps OU fixedCents
  fixedCents    Int?
  startsAt      DateTime                @default(now())
  endsAt        DateTime?
  createdAt     DateTime                @default(now())
  agent         SalesAgent?             @relation(fields: [agentId], references: [id])
  agency        Agency?                 @relation(fields: [agencyId], references: [id])
  entries       CommissionEntry[]

  @@index([eventId, recipientKind, startsAt])
  // Validar destinatário, faixa da taxa e ausência de regras vigentes sobrepostas.
}

model CommissionEntry {
  id              String              @id @default(cuid())
  attributionId   String
  ruleId          String
  orderId         String?
  promoterName    String?
  kind            CommissionEntryKind
  label           String?
  ticketType      String?
  amountCents     Int                 // Reversão e liquidação como valores negativos
  amount          Decimal             @default(0) @db.Decimal(12, 2)
  currency        String              @default("BRL")
  status          String?             @default("Disponível")
  sourceEventId   String              @unique // ID único do evento de pagamento/estorno/repasse
  ledgerEntryId   String?             @unique // Referência ao Ledger existente
  reversesEntryId String?
  createdAtText   String?
  createdAt       DateTime            @default(now())
  attribution     SaleAttribution     @relation(fields: [attributionId], references: [id])
  rule            CommissionRule      @relation(fields: [ruleId], references: [id])

  @@index([attributionId, createdAt])
  // Append-only: proibido atualizar ou excluir lançamentos financeiros.
}
